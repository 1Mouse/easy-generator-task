meta {
  name: List Orders
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/orders?page=1&pageSize=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 10
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Protected endpoint — run Sign Up or Sign In first to populate {{accessToken}}.
}
