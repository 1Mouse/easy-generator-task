meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{signUpEmail}}",
    "name": "{{signUpName}}",
    "password": "{{signUpPassword}}"
  }
}

docs {
  Signup no longer returns an accessToken — it creates an unverified
  account and sends a verification email. Check Mailpit's inbox UI at
  http://localhost:8025, copy the token from the link in the email into
  the `verificationToken` environment variable, then run "Verify Email"
  to activate the account and receive an accessToken.
}
