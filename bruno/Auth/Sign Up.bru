meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "{{signUpEmail}}",
    "name": "{{signUpName}}",
    "password": "{{signUpPassword}}"
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.accessToken) {
    bru.setEnvVar("accessToken", body.accessToken);
  }
}
