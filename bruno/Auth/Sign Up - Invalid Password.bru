meta {
  name: Sign Up - Invalid Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "invalid-password@example.com",
    "name": "No Digits",
    "password": "NoDigitsOrSpecial"
  }
}

docs {
  Expected: 400 — password is missing a digit and a special character.
}
