meta {
  name: Verify Email
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{verificationToken}}"
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.accessToken) {
    bru.setEnvVar("accessToken", body.accessToken);
  }

  if (body?.refreshToken) {
    bru.setEnvVar("refreshToken", body.refreshToken);
  }
}

docs {
  Paste the token from Mailpit (http://localhost:8025) into the
  `verificationToken` environment variable before running this. Success
  marks the account verified and starts a session — the response carries
  the user plus an accessToken and refreshToken, both captured into the
  environment by the script above.
}
